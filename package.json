{
  "name": "@kodyazicam/envsentinel",
  "version": "1.0.1",
  "description": "Validate .env files against a schema, scan for leaked secrets, generate TypeScript types, and expose an MCP server for AI agents.",
  "keywords": [
    "env",
    "dotenv",
    "validation",
    "secrets",
    "typescript",
    "cli",
    "12factor",
    "mcp",
    "model-context-protocol",
    "ai-agent",
    "llm-tools"
  ],
  "license": "Apache-2.0",
  "author": "Batuhan (KodYazicam) <https://github.com/KodYazicam>",
  "homepage": "https://github.com/KodYazicam/envsentinel",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KodYazicam/envsentinel.git"
  },
  "bugs": {
    "url": "https://github.com/KodYazicam/envsentinel/issues"
  },
  "type": "module",
  "sideEffects": false,
  "bin": {
    "envsentinel": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp.d.ts",
      "import": "./dist/mcp.js"
    }
  },
  "files": [
    "dist",
    "assets/banner.svg",
    "LICENSE",
    "README.md",
    "SECURITY.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "prepublishOnly": "npm test && npm run typecheck",
    "test": "npm run typecheck && vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^5.1.0",
    "typescript": "^5.7.0",
    "vitest": "^5.1.0"
  },
  "optionalDependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "zod": "^4.6.7"
  }
}
