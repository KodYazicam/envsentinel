{
  "name": "envsentinel-demo",
  "fields": {
    "PORT": {
      "type": "number",
      "default": "3000",
      "description": "HTTP port"
    },
    "DATABASE_URL": {
      "type": "url",
      "required": true,
      "description": "Database connection string (postgres:// or https://)"
    },
    "NODE_ENV": {
      "type": "enum",
      "values": ["development", "test", "production"]
    },
    "DEBUG": {
      "type": "boolean",
      "required": false
    }
  }
}
